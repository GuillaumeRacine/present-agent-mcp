# Present Agent MCP — configuration (all optional).
# This package ships with safe defaults and needs NO secrets to run.
# The hosted server calls the public Present Agent API; you do not provide
# any API keys, model-provider keys, or Shopify credentials here.

# Which client is calling (used only for attribution/analytics labels).
# Examples: claude-code, codex, cursor, custom
PRESENT_AGENT_CLIENT=claude-code

# Point at a non-default API base (defaults to https://presentagent.vip).
# Only change this if you run your own Present Agent instance.
# PRESENT_AGENT_API_BASE=https://presentagent.vip

# Opt in to local agent-context search (OFF by default).
# When set to 1 AND you pass useAgentContext=true on a tool call, the server
# may scan local Claude/Codex/Gemini context files for soft signals about the
# named recipient. Secret-looking lines/paths are skipped; only compact,
# sanitized preference/need/constraint hints are sent — never raw files.
# PRESENT_ENABLE_LOCAL_AGENT_CONTEXT=0

# Echo the local-context lines back in the tool response (debug only, OFF by default).
# PRESENT_EXPOSE_LOCAL_AGENT_CONTEXT_LINES=0
